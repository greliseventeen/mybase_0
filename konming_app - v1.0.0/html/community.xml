<!--
存放路径：D:\Android app\run_temp\konming_app\html\community.xml

页面布局结构描述：

根布局：
- ConstraintLayout 或 LinearLayout（垂直排列）
- 背景色：#F5F5F5

包含以下子控件（按顺序从上到下）：

1. 顶部标题栏
   - ConstraintLayout 或 LinearLayout
     - 背景色：#FFFFFF
     - 顶部内边距：48dp（适配状态栏）
     - 左右内边距：16dp
     - 底部内边距：16dp
   - TextView：标题"社区"
     - 文本大小：20sp
     - 字体粗细：bold
     - 文字颜色：#1A1A1A

2. 下拉刷新提示
   - LinearLayout（水平居中）
     - 背景色：#FFFFFF
     - 内边距：上下8dp
   - TextView："下拉刷新"
     - 文本大小：12sp
     - 文字颜色：#757575

3. 内容列表区域
   - SwipeRefreshLayout
     - 包含 RecyclerView
   - RecyclerView
     - 宽：match_parent
     - 高：0dp（weight=1）
     - 布局管理器：LinearLayoutManager（VERTICAL）
     - Item间距：12dp
     - 背景色：#F5F5F5
     - 内边距：左右16dp，上下12dp
     - clipToPadding：false
   - 空状态视图（默认隐藏）
     - ConstraintLayout（居中）
     - ImageView：空状态插画
       - 宽高：128dp
       - 背景：#F5F5F5 圆形
     - TextView："暂无社区动态，去发个帖子吧~"
       - 文本大小：14sp
       - 文字颜色：#757575
       - 上边距：24dp

4. 帖子Item布局
   - CardView
     - 圆角：12dp
     - 阴影：轻微
     - 背景色：#FFFFFF
     - 宽：match_parent
   - ConstraintLayout（父容器）
     - 内边距：16dp
     - ImageView：发布者头像
       - 宽高：40dp
       - 背景：#BDBDBD（灰色占位），圆形
       - 或使用真实图片
     - TextView：昵称
       - 与头像右边距：12dp
       - 文本大小：14sp
       - 字体粗细：semibold
       - 文字颜色：#1A1A1A
     - TextView：发布时间
       - 在昵称下方
       - 文本大小：12sp
       - 文字颜色：#757575
       - 上边距：2dp
     - TextView：正文内容
       - 在头像下方，顶边距12dp
       - 文本大小：14sp
       - 文字颜色：#1A1A1A
       - 最大行数：3（可展开）
       - ellipsize：end
       - 行高：1.5倍
     - TextView（可选）："展开"链接
       - 在正文末尾
       - 文本大小：14sp
       - 文字颜色：#C41E3A
       - 字体粗细：medium
     - RecyclerView/GridLayout（可选）：图片网格
       - 在正文下方，顶边距12dp
       - 列数：3
       - Item间距：8dp
       - 图片：
         - 宽高：match_parent（按比例）
         - 圆角：8dp
         - scaleType：centerCrop
         - 支持1张、4张、9张等不同数量
     - LinearLayout（水平排列）：互动按钮
       - 在内容下方，顶边距12dp
       - ImageButton：点赞按钮
         - 宽高：20dp
         - 未选中：灰色心形（线性）
         - 选中：红色心形（填充）
       - TextView：点赞数
         - 与按钮左边距：6dp
         - 文本大小：13sp
         - 文字颜色：#757575
       - ImageButton：评论按钮
         - 宽高：20dp
         - 灰色气泡图标（线性）
         - 左边距：24dp
       - TextView：评论数
         - 与按钮左边距：6dp
         - 文本大小：13sp
         - 文字颜色：#757575
   - LinearLayout（评论预览，可选）
     - 背景色：#F5F5F5
     - 圆角：8dp
     - 内边距：12dp
     - 左右内边距：16dp
     - 上边距：0
     - 底部内边距：16dp
     - ImageView：评论者头像
       - 宽高：28dp
       - 背景：#BDBDBD（灰色占位），圆形
     - LinearLayout（垂直排列）
       - 与头像右边距：8dp
       - TextView：评论者昵称 + "："
         - 文本大小：13sp
         - 昵称字体粗细：semibold，昵称颜色#1A1A1A，冒号颜色#757575
       - TextView：评论内容
         - 文本大小：13sp
         - 文字颜色：#757575
         - 上边距：2dp

5. 加载更多（RecyclerView底部Item）
   - LinearLayout（水平居中，垂直排列）
     - 内边距：上下24dp
   - ProgressBar：加载进度条
     - 宽高：16dp
     - 颜色：#C41E3A
   - TextView："加载更多..."
     - 文本大小：14sp
     - 文字颜色：#757575
     - 左边距：8dp

6. 底部导航栏
   - LinearLayout（水平排列）
     - 高度：56dp
     - 背景色：#FFFFFF
     - 顶部边框：1px #F0F0F0
     - 权重：平均分配
   - 导航项（5个）
     - LinearLayout（垂直居中）
     - ImageView：图标
       - 宽高：24dp
       - 选中：#C41E3A
       - 未选中：#BDBDBD
     - TextView：文字
       - 文本大小：10sp
       - 上边距：2dp
       - 选中：#C41E3A
       - 未选中：#BDBDBD
   - 中间发布按钮
     - FrameLayout
       - 宽高：48dp
       - 背景：#C41E3A 圆形
       - 上移：-16dp
       - 阴影：明显
     - ImageView：加号图标
       - 宽高：24dp
       - 颜色：#FFFFFF
       - 居中

关键属性说明：
- 整体页面宽度固定为412px
- 帖子列表可滚动
- 支持正文展开/收起
- 图片九宫格灵活布局（1、3、4、9张等）
- 点赞状态切换
- 评论预览展示
- 所有圆角统一：按钮8dp，卡片12dp
- 选中状态主色高亮
-->

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="社区"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>

    </LinearLayout>

    <!-- 下拉刷新提示 -->
    <LinearLayout
        android:id="@+id/refreshIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下拉刷新"
            android:textSize="12sp"
            android:textColor="#757575"/>

    </LinearLayout>

    <!-- 内容列表 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/refreshIndicator"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"/>

        <!-- 空状态视图 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="64dp"
            android:paddingBottom="64dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/empty_state_background">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_community_empty"
                    android:tint="#D0D0D0"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="暂无社区动态，去发个帖子吧~"
                android:textSize="14sp"
                android:textColor="#757575"/>

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 推荐 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="推荐"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

        <!-- 智能体 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="智能体"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

        <!-- 发布按钮 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/fab_background"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    android:tint="#FFFFFF"/>

            </FrameLayout>

        </FrameLayout>

        <!-- 社区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_community"
                android:tint="#C41E3A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="社区"
                android:textSize="10sp"
                android:textColor="#C41E3A"/>

        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="我的"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>