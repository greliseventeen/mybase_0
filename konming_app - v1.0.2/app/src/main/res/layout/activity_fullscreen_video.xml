<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_fullscreen_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreen_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="fit"/>

    <LinearLayout
        android:id="@+id/layout_fullscreen_controls"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#B0FFFFFF"
        android:visibility="visible"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/iv_fullscreen_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="播放/暂停"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_fullscreen_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginStart="8dp"/>

        <SeekBar
            android:id="@+id/fullscreen_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"/>

        <TextView
                android:id="@+id/tv_fullscreen_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#1A1A1A"
                android:textSize="14sp"/>

            <ImageView
                android:id="@+id/iv_fullscreen_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="设置"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_speed_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="96dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone"
            android:elevation="8dp"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_speed_0_5x"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="0.5x"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

            <TextView
                android:id="@+id/tv_speed_1_0x"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="1.0x"
                android:textColor="#C41E3A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

            <TextView
                android:id="@+id/tv_speed_1_5x"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="1.5x"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

            <TextView
                android:id="@+id/tv_speed_2_0x"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="2.0x"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

        </LinearLayout>

    <ImageView
        android:id="@+id/iv_back_fullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="返回"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <LinearLayout
        android:id="@+id/layout_orientation_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:layout_margin="8dp"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iv_portrait"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="竖屏"
                android:scaleType="centerInside"
                android:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:rotation="0"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="竖屏"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/iv_landscape"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="横屏"
                android:scaleType="centerInside"
                android:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:rotation="90"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="横屏"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>