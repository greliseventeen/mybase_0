<!--
存放路径：D:\Android app\run_temp\konming_app\html\upload_post.xml

页面布局结构描述：

根布局：
- ConstraintLayout 或 LinearLayout（垂直排列）
- 背景色：#F5F5F5

包含以下子控件（按顺序从上到下）：

1. 顶部标题栏
   - ConstraintLayout 或 LinearLayout
     - 背景色：#FFFFFF
     - 顶部内边距：48dp（适配状态栏）
     - 左右内边距：16dp
     - 底部内边距：16dp
   - ImageButton：返回按钮
     - 宽高：wrap_content
     - 内边距：4dp
     - 图标：返回箭头（线性风格）
     - 颜色：#1A1A1A
   - TextView：标题"发帖"
     - 文本大小：20sp
     - 字体粗细：bold
     - 文字颜色：#1A1A1A
     - 居中显示
   - Button：存草稿
     - 文本大小：14sp
     - 文字颜色：#757575
     - 字体粗细：medium
     - 背景：透明
   - Button：发布按钮
     - 与存草稿按钮右边距：12dp
     - 内边距：左右20dp，上下8dp
     - 背景色：#C41E3A
     - 圆角：8dp
     - 文本大小：14sp
     - 文字颜色：#FFFFFF
     - 字体粗细：semibold

2. 内容编辑区
   - ScrollView（可选）
     - 背景色：#F5F5F5
     - 内边距：16dp
   - CardView：文本输入卡片
     - 圆角：12dp
     - 阴影：轻微
     - 背景色：#FFFFFF
     - 内边距：16dp
     - EditText：内容输入框
       - 宽：match_parent
       - 高：200dp（或wrap_content，最小高度）
       - 背景：透明
       - 文本大小：14sp
       - 文字颜色：#1A1A1A
       - 提示文字："分享你的政策学习心得..."
       - 提示文字颜色：#757575
       - 输入类型：textMultiLine
       - 最大行数：不限
       - gravity：top|start
       - lineSpacingExtra：4dp
   - CardView：图片区域卡片
     - 与上方卡片间距：16dp
     - 圆角：12dp
     - 阴影：轻微
     - 背景色：#FFFFFF
     - 内边距：16dp
     - GridLayout/RecyclerView：图片网格
       - 列数：4
       - Item间距：12dp
       - ConstraintLayout：图片Item（已添加）
         - ImageView：图片
           - 宽高：match_parent
           - 圆角：8dp
           - scaleType：centerCrop
         - ImageButton：删除按钮
           - 位置：右上角（-6dp偏移）
           - 宽高：20dp
           - 背景色：#666666（灰色）
           - 圆形
           - 图标：×
           - 颜色：#FFFFFF
           - 图标大小：12dp
       - Button：添加图片按钮
         - 宽高：match_parent（aspect ratio 1:1）
         - 背景：透明，虚线边框2dp #BDBDBD，圆角8dp
         - 背景色：#F5F5F5
         - 图标：+
         - 图标颜色：#BDBDBD
         - 图标大小：28dp

3. 底部权限提示卡片
   - CardView
     - 左右内边距：16dp
     - 底部内边距：16dp
     - 圆角：8dp
     - 背景色：#FFF8E1（浅黄）
     - 边框：1px #FFE082
     - 内边距：12dp
     - ImageView：提示图标
       - 宽高：20dp
       - 颜色：#FFA000
       - 上边距：2dp
     - TextView：权限提示文字
       - 与图标右边距：12dp
       - 文本大小：13sp
       - 文字颜色：#FF8F00
       - 文本："需要相册权限用于选择图片"
     - Button：去设置
       - 文本大小：13sp
       - 文字颜色：#C41E3A
       - 字体粗细：medium
       - 背景：透明

4. 底部导航栏
   - LinearLayout（水平排列）
     - 高度：56dp
     - 背景色：#FFFFFF
     - 顶部边框：1px #F0F0F0
     - 权重：平均分配
   - 导航项（5个）
     - LinearLayout（垂直居中）
     - ImageView：图标
       - 宽高：24dp
       - 选中：#C41E3A
       - 未选中：#BDBDBD
     - TextView：文字
       - 文本大小：10sp
       - 上边距：2dp
       - 选中：#C41E3A
       - 未选中：#BDBDBD
   - 中间发布按钮
     - FrameLayout
       - 宽高：48dp
       - 背景：#C41E3A 圆形
       - 上移：-16dp
       - 阴影：明显
     - ImageView：加号图标
       - 宽高：24dp
       - 颜色：#FFFFFF
       - 居中

5. 底部操作表（BottomSheet）
   - FrameLayout（全屏，半透明黑色遮罩）
     - 背景色：#000000（50%透明度）
   - LinearLayout（底部卡片）
     - 背景色：#FFFFFF
     - 圆角：顶部24dp
     - 内边距：左右16dp，顶部8dp，底部32dp
     - View：顶部把手
       - 宽高：48dp 4dp
       - 背景色：#E0E0E0
       - 圆角：2dp
       - 居中，顶部边距8dp，底部边距24dp
     - ConstraintLayout/LinearLayout：选项列表
       - 垂直排列，间距12dp
       - Button：发帖（选中/高亮）
         - 宽高：match_parent
         - 高：56dp
         - 背景色：#C41E3A
         - 圆角：12dp
         - 图标：编辑图标（线性）
         - 图标颜色：#FFFFFF
         - 图标与文字间距：8dp
         - 文本："发帖"
         - 文本大小：16sp
         - 文字颜色：#FFFFFF
         - 字体粗细：semibold
       - Button：上传音视频/文章
         - 宽高：match_parent
         - 高：56dp
         - 背景色：#FFFFFF
         - 边框：1px #E0E0E0
         - 圆角：12dp
         - 图标：上传图标（线性）
         - 图标颜色：#757575
         - 图标与文字间距：8dp
         - 文本："上传音视频/文章"
         - 文本大小：16sp
         - 文字颜色：#1A1A1A
         - 字体粗细：medium

关键属性说明：
- 整体页面宽度固定为412px
- 内容区域可滚动
- 图片网格支持动态添加/删除
- 权限提示为浅黄背景
- 底部操作表为半透明遮罩+白色卡片
- 所有圆角统一：按钮8dp，卡片12dp，操作表卡片顶部24dp
- 选中状态主色高亮
-->

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingTop="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            android:tint="#1A1A1A"
            android:contentDescription="返回"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="发帖"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>

        <Button
            android:id="@+id/saveDraftButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="存草稿"
            android:textSize="14sp"
            android:textStyle="medium"
            android:textColor="#757575"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>

        <Button
            android:id="@+id/publishButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/publish_button_background"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="发布"
            android:textSize="14sp"
            android:textStyle="semibold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- 内容编辑区 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:layout_constraintBottom_toTopOf="@id/permissionHint">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 文本输入卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <EditText
                    android:id="@+id/contentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@null"
                    android:padding="16dp"
                    android:textSize="14sp"
                    android:textColor="#1A1A1A"
                    android:hint="分享你的政策学习心得..."
                    android:textColorHint="#757575"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:lineSpacingExtra="4dp"/>

            </androidx.cardview.widget.CardView>

            <!-- 图片区域卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <GridLayout
                        android:id="@+id/imageGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:rowCount="2">

                        <!-- 已添加图片Item示例 -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_aspectRatio="1"
                                android:src="@drawable/placeholder_image"
                                android:scaleType="centerCrop"
                                android:background="@drawable/image_background"/>

                            <ImageButton
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="-6dp"
                                android:layout_marginEnd="-6dp"
                                android:background="@drawable/delete_button_background"
                                android:src="@drawable/ic_close"
                                android:tint="#FFFFFF"
                                android:padding="4dp"
                                android:contentDescription="删除图片"/>

                        </FrameLayout>

                        <!-- 添加图片按钮 -->
                        <Button
                            android:id="@+id/addImageButton"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_aspectRatio="1"
                            android:layout_margin="6dp"
                            android:background="@drawable/add_image_button_background"
                            android:drawableTop="@drawable/ic_add"
                            android:drawablePadding="0dp"
                            android:paddingTop="24dp"/>

                    </GridLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- 权限提示卡片 -->
    <LinearLayout
        android:id="@+id/permissionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFF8E1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:elevation="0dp"
        android:background="@drawable/permission_hint_background"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_warning"
            android:tint="#FFA000"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="需要相册权限用于选择图片"
            android:textSize="13sp"
            android:textColor="#FF8F00"/>

        <Button
            android:id="@+id/goToSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="去设置"
            android:textSize="13sp"
            android:textStyle="medium"
            android:textColor="#C41E3A"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>

    </LinearLayout>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 推荐 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="推荐"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

        <!-- 智能体 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="智能体"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

        <!-- 发布按钮 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/fab_background"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    android:tint="#FFFFFF"/>

            </FrameLayout>

        </FrameLayout>

        <!-- 社区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_community"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="社区"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person"
                android:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="我的"
                android:textSize="10sp"
                android:textColor="#BDBDBD"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>