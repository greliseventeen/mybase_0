                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="退出登录"
                            android:textSize="15sp"
                            android:textColor="#C41E3A"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

